//go:build e2e

package e2e

import (
	"fmt"
	"net"
	"testing"
)

// Exercise the actual local CottenMax client/server against the real router.
func TestCottenRouterLocalCottenMax(t *testing.T) {
	for _, transport := range []string{"udp", "tcp"} {
		t.Run(transport, func(t *testing.T) {
			server, client := cottenMaxSettings(t)
			client += fmt.Sprintf("RESOLVER_TRANSPORT = %q\nTERMINAL_UI = \"plain\"\nSTARTUP_MODE = \"resolvers\"\n", transport)
			resolver := func(t *testing.T, server *net.UDPAddr) []string {
				return []string{startRouter(t, server).String()}
			}
			runTunnelEchoVia(t, 3, 3, server+routerServerEdits, `["TXT"]`, client, "127.0.0.1", tunnelBins{}, resolver)
		})
	}
}

// Enabling CottenMax in CottenDNS must keep normal clients working on the
// same server configuration and the same single CottenDNS router entry.
func TestCottenRouterLocalNormalClientsWithCottenMaxEnabled(t *testing.T) {
	for _, method := range []int{1, 3} {
		t.Run(fmt.Sprintf("encryption=%d", method), func(t *testing.T) {
			server, _ := cottenMaxSettings(t)
			resolver := func(t *testing.T, server *net.UDPAddr) []string {
				return []string{startRouter(t, server).String()}
			}
			runTunnelEchoVia(t, 3, method, server+routerServerEdits, `["TXT"]`, "TUNNEL_MODE = \"legacy\"\nSTARTUP_MODE = \"resolvers\"\nTERMINAL_UI = \"plain\"\n", "127.0.0.1", tunnelBins{}, resolver)
		})
	}
}
